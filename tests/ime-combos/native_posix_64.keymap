/*
 * 英数/かな コンボ (config/KobitoKey.keymap の combo_eisu / combo_kana)。
 *
 * D+F -> LANG2 (英数) / J+K -> LANG1 (かな)。timeout-ms = 80 は
 * 「2 本指のズレで取りこぼす」と「ローマ字入力中に誤爆する」の
 * トレードオフそのもので、値を触ったときの影響が一番読みにくい。
 * 境界 (70ms で成立 / 100ms で不成立) を両方固定する。
 *
 * layers を指定していない = 全レイヤーで有効、も設計意図なので固定する。
 * オートマウスレイヤー滞在中でも IME 切替を優先するための指定で、
 * `layers = <0>` を足すと壊れる。
 *
 * mock kscan は実機と同じ 4 行 10 列に広げてあるので、position は
 * config/KobitoKey.keymap と同じ番号で書ける (12=D 13=F 16=J 17=K)。
 */

#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    combos {
        compatible = "zmk,combos";

        /* config/KobitoKey.keymap と同一に保つこと (doctor.sh が検査する) */
        combo_eisu {
            timeout-ms = <80>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <80>;
            key-positions = <16 17>;
            bindings = <&kp LANG1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W     &kp E     &kp R     &kp T     &kp Y   &kp U   &kp I      &kp O    &kp P
&kp A      &kp S     &kp D     &kp F     &kp G     &kp H   &kp J   &kp K      &kp L    &kp SEMI
&kp Z      &kp X     &kp C     &kp V     &kp B     &kp N   &kp M   &kp COMMA  &kp DOT  &kp APOS
&mo 1      &none     &none     &none     &none     &none   &none   &none      &none    &none
            >;
        };

        /* 高番レイヤー滞在中でもコンボが成立することの確認用。
         * D/F/J/K の位置は &trans にしておき、コンボが効かなかった場合は
         * Layer 0 の素の文字が出る = 差分で分かるようにする。 */
        layer1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

&kscan {
    rows = <4>;
    columns = <10>;

    events = <
        /* A: D+F をほぼ同時 -> LANG2 (英数) */
        ZMK_MOCK_PRESS(1,2,10)
        ZMK_MOCK_PRESS(1,3,10)
        ZMK_MOCK_RELEASE(1,2,10)
        ZMK_MOCK_RELEASE(1,3,400)

        /* B: J+K をほぼ同時 -> LANG1 (かな) */
        ZMK_MOCK_PRESS(1,6,10)
        ZMK_MOCK_PRESS(1,7,10)
        ZMK_MOCK_RELEASE(1,6,10)
        ZMK_MOCK_RELEASE(1,7,400)

        /* C: timeout 内 (70ms) なら成立する — 境界の下側 */
        ZMK_MOCK_PRESS(1,2,70)
        ZMK_MOCK_PRESS(1,3,10)
        ZMK_MOCK_RELEASE(1,2,10)
        ZMK_MOCK_RELEASE(1,3,400)

        /* D: timeout を超える (100ms) と成立せず D と F が個別に出る
         *    — 境界の上側。ローマ字入力で df と打ったときの挙動 */
        ZMK_MOCK_PRESS(1,2,100)
        ZMK_MOCK_PRESS(1,3,10)
        ZMK_MOCK_RELEASE(1,2,10)
        ZMK_MOCK_RELEASE(1,3,400)

        /* E: Layer 1 滞在中でも D+F が成立する (layers 未指定 = 全レイヤー)。
         *    ここが赤くなったら combo に layers が足されたというシグナル */
        ZMK_MOCK_PRESS(3,0,10)
        ZMK_MOCK_PRESS(1,2,10)
        ZMK_MOCK_PRESS(1,3,10)
        ZMK_MOCK_RELEASE(1,2,10)
        ZMK_MOCK_RELEASE(1,3,10)
        ZMK_MOCK_RELEASE(3,0,10)
    >;
};
